{
  "name": "platform",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/graphql-hive/console"
  },
  "author": {
    "email": "contact@the-guild.dev",
    "name": "The Guild",
    "url": "https://the-guild.dev"
  },
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "engines": {
    "node": ">=24.18.1",
    "pnpm": ">=10.33.2"
  },
  "scripts": {
    "build": "pnpm turbo build --filter='@hive/app' --concurrency=1 --color && pnpm turbo build --concurrency=4 --color --filter '!@hive/app'",
    "build:libraries": "pnpm prebuild && pnpm graphql:generate && pnpm turbo build --filter=./packages/libraries/* --color",
    "build:services": "pnpm prebuild && pnpm turbo build --filter=./packages/services/**/* --filter=./packages/migrations --color",
    "build:web": "pnpm prebuild && pnpm turbo build --filter=./packages/web/* --color",
    "dev:hive": "turbo dev:hive --ui tui --concurrency 100",
    "dev:integration": "cd integration-tests && pnpm dev:integration",
    "dev:observability": "docker compose -f ./docker/docker-compose.dev.yml --profile observability up -d",
    "dev:observability:down": "docker compose -f ./docker/docker-compose.dev.yml --profile observability down",
    "dev:zendesk-mock": "docker compose -f ./docker/docker-compose.dev.yml --profile zendesk up -d",
    "dev:zendesk-mock:down": "docker compose -f ./docker/docker-compose.dev.yml --profile zendesk down",
    "docker:build": "NODE_VERSION_TAG=\":$(< .node-version)-slim\" docker buildx bake -f docker/docker.hcl --load build",
    "docker:override-up": "docker compose -f ./docker/docker-compose.override.yml up -d --remove-orphans",
    "env:sync": "tsx scripts/sync-env-files.ts",
    "foundry": "pnpm --filter @hive/app foundry",
    "generate": "pnpm --filter @hive/storage db:generate && pnpm graphql:generate",
    "graphql:generate": "VERBOSE=1 graphql-codegen --config codegen.mts",
    "graphql:generate:watch": "pnpm graphql:generate --watch",
    "integration:prepare": "cd integration-tests && ./local.sh",
    "lint": "NODE_OPTIONS=\"--max-old-space-size=8192\" eslint --cache --ignore-path .gitignore \"{packages,e2e}/**/*.{ts,tsx,graphql}\"",
    "lint:env-template": "tsx scripts/check-env-template.ts",
    "lint:fix": "pnpm lint --fix",
    "lint:prettier": "prettier --cache --check .",
    "local:setup": "docker compose -f ./docker/docker-compose.dev.yml up -d --build --remove-orphans && pnpm --filter @hive/migrations db:init",
    "postinstall": "node ./scripts/patch-manifests.js && pnpm env:sync && node ./scripts/turborepo-cleanup.js",
    "prebuild": "rimraf deploy-tmp && rimraf packages/**/deploy-tmp",
    "prerelease": "pnpm build:libraries",
    "prettier": "prettier --cache --write --list-different --ignore-unknown \"**/*\"",
    "release": "pnpm build:libraries && changeset publish",
    "release:version": "changeset version && pnpm build:libraries && pnpm --filter @graphql-hive/cli oclif:readme",
    "seed:alerts-live": "tsx scripts/seed-alerts-live/seed-alerts-live.mts",
    "seed:alerts-live:cleanup": "tsx scripts/seed-alerts-live/cleanup.mts",
    "seed:app-deployment-checks": "tsx scripts/seed-app-deployment-checks.mts",
    "seed:app-deployments": "tsx scripts/seed-app-deployments.mts",
    "seed:history": "tsx scripts/seed-history/seed-history.mts",
    "seed:insights-and-alerts": "tsx scripts/seed-insights-and-alerts/seed-insights-and-alerts.mts",
    "seed:org": "tsx scripts/seed-organization.mts",
    "seed:schemas": "tsx scripts/seed-schemas.ts",
    "seed:scim-users-groups": "tsx scripts/seed-scim-users-groups/seed-scim-users-groups.mts",
    "seed:stitching-checks": "tsx scripts/seed-stitching-checks.mts",
    "seed:usage": "tsx scripts/seed-usage.ts",
    "sourcemaps:inject": "./scripts/sourcemaps-inject.sh",
    "sourcemaps:upload": "./scripts/sourcemaps-upload.sh",
    "start": "pnpm run local:setup",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "RUN_AGAINST_LOCAL_SERVICES=1 HIVE_APP_BASE_URL=http://localhost:3000 playwright test --ui",
    "test:e2e:open": "playwright test --ui",
    "test:integration": "cd integration-tests && pnpm test:integration",
    "test:integration:local": "pnpm run --filter integration-tests test:local",
    "typecheck": "pnpm run -r --filter '!hive' typecheck",
    "workspace": "pnpm run --filter $1 $2"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "1.15.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@eddeee888/gcg-typescript-resolver-files": "0.20.0",
    "@graphql-codegen/add": "7.1.1",
    "@graphql-codegen/cli": "7.4.5",
    "@graphql-codegen/client-preset": "6.2.2",
    "@graphql-codegen/schema-ast": "6.1.1",
    "@graphql-codegen/typescript": "6.1.1",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@graphql-codegen/urql-introspection": "4.0.1",
    "@graphql-eslint/eslint-plugin": "catalog:",
    "@graphql-inspector/cli": "7.0.0",
    "@graphql-inspector/core": "8.0.0",
    "@graphql-inspector/patch": "catalog:",
    "@graphql-tools/load": "8.1.19",
    "@manypkg/get-packages": "catalog:",
    "@parcel/watcher": "2.5.1",
    "@playwright/test": "1.60.0",
    "@sentry/cli": "2.40.0",
    "@swc/core": "catalog:",
    "@theguild/eslint-config": "0.12.1",
    "@theguild/federation-composition": "catalog:",
    "@theguild/prettier-config": "2.0.7",
    "@types/node": "catalog:",
    "bob-the-bundler": "7.0.1",
    "dotenv": "catalog:",
    "eslint": "8.57.1",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "eslint-plugin-hive": "file:rules",
    "graphql": "catalog:",
    "jest-snapshot-serializer-raw": "2.0.0",
    "pg": "8.13.1",
    "prettier": "catalog:",
    "prettier-plugin-sql": "0.18.1",
    "prettier-plugin-tailwindcss": "0.6.9",
    "rimraf": "6.1.3",
    "tailwindcss": "catalog:",
    "tsup": "8.4.0",
    "tsx": "catalog:",
    "turbo": "2.9.14",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides.esbuild": "To address CVE: https://github.com/graphql-hive/console/security/dependabot/259",
    "overrides.csstype": "To fix type check error https://github.com/JedWatson/react-select/issues/5952",
    "overrides.mjml": "Our patch removes html-minifier from mjml-core, we dont need this dependency and its causing false-alarm (CVE https://nvd.nist.gov/vuln/detail/cve-2022-37620)",
    "overrides.ip": "There is no update with fix for ip package, we use fork https://github.com/indutny/node-ip/issues/150#issuecomment-2325961380",
    "overrides.tar-fs": "https://github.com/graphql-hive/console/security/dependabot/290",
    "overrides.@types/nodemailer>@aws-sdk/client-sesv2": "@types/nodemailer depends on some AWS stuff that causes the 3.x.x version to stick around. We don't need that dependency. (https://github.com/graphql-hive/console/security/dependabot/436)",
    "overrides.tar@6.x.x": "address https://github.com/graphql-hive/console/security/dependabot/443",
    "overrides.diff@<8.0.3": "address https://github.com/graphql-hive/console/security/dependabot/438",
    "overrides.lodash-es@4.x.x": "address https://github.com/graphql-hive/console/security/dependabot/453",
    "overrides.lodash@4.x.x": "address https://github.com/graphql-hive/console/security/dependabot/455",
    "overrides.fast-xml-parser@5.x.x": "address https://github.com/graphql-hive/console/security/dependabot/576",
    "overrides.minimatch@10.x.x": "address https://github.com/graphql-hive/console/security/dependabot/505",
    "overrides.ajv@8.x.x": "address https://github.com/graphql-hive/console/security/dependabot/507",
    "overrides.yauzl@2.x.x": "address https://github.com/graphql-hive/console/security/dependabot/542",
    "overrides.path-to-regexp@0.x.x": "address https://github.com/graphql-hive/console/security/dependabot/619",
    "overrides.graphile-worker>@types/pg": "Keep graphile-worker on the catalog @types/pg version; a newer transitive @types/pg makes the pg Pool passed in services/workflows/src/kit.ts type-incompatible",
    "overrides.@graphql-hive/gateway-plugin-console-sdk": "Use the in-repository version.",
    "overrides.@graphql-hive/yoga": "Use the in-repository version.",
    "overrides.@graphql-hive/core": "Use the in-repository version.",
    "overrides": {
      "graphile-worker>@types/pg": "8.11.10",
      "esbuild": "0.28.1",
      "csstype": "3.1.2",
      "mjml-core@4.14.0>html-minifier": "-",
      "mjml-cli@4.14.0>html-minifier": "-",
      "ws@^8.0.0": "^8.21.0",
      "ws@*": ">=8.21.0 || >=7.5.10 || >=6.2.3 || >=5.2.4",
      "cookie@<0.7.0": "0.7.2",
      "tar-fs": "2.1.4",
      "ip": "npm:neoip@2.1.0",
      "estree-util-value-to-estree": "^3.3.3",
