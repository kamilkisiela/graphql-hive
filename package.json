      "sha.js@<=2.4.11": ">=2.4.12",
      "@sigstore/core@<=3.2.0": ">=3.2.1",
      "js-yaml@<3.15.2": "3.15.2",
      "sigstore@<=4.1.0": ">=4.1.1",
      "tar@<=7.5.18": "7.5.21",
      "fast-uri@<4.0.0": "3.1.7",
      "@opentelemetry/propagator-jaeger@<2.9.0": "2.9.0",
      "sharp@<0.35.4": "^0.35.4",
      "body-parser@1.x.x": "1.20.6",
      "prettier-plugin-sh": "0.19.0",
      "pacote@<21.5.1": "^21.5.1",
