            type: boolean,
          },
          EnumTypeDefinition: {
            description: Read more about this kind on [spec.graphql.org](https://spec.graphql.org/October2021/#EnumTypeDefinition).,
            type: boolean,
          },
          EnumValueDefinition: {
            description: Read more about this kind on [spec.graphql.org](https://spec.graphql.org/October2021/#EnumValueDefinition).,
            type: boolean,
          },
          FieldDefinition: {
            description: Read more about this kind on [spec.graphql.org](https://spec.graphql.org/October2021/#FieldDefinition).,
            type: boolean,
          },
          InputObjectTypeDefinition: {
            description: Read more about this kind on [spec.graphql.org](https://spec.graphql.org/October2021/#InputObjectTypeDefinition).,
            type: boolean,
          },
          InputValueDefinition: {
            description: Read more about this kind on [spec.graphql.org](https://spec.graphql.org/October2021/#InputValueDefinition).,
            type: boolean,
          },
          InterfaceTypeDefinition: {
            description: Read more about this kind on [spec.graphql.org](https://spec.graphql.org/October2021/#InterfaceTypeDefinition).,
            type: boolean,
          },
          ObjectTypeDefinition: {
            description: Read more about this kind on [spec.graphql.org](https://spec.graphql.org/October2021/#ObjectTypeDefinition).,
            type: boolean,
          },
          OperationDefinition: {
            description: Read more about this kind on [spec.graphql.org](https://spec.graphql.org/October2021/#OperationDefinition).
> You must use only comment syntax \`#\` and not description syntax \`"""\` or \`"\`.,
            type: boolean,
          },
          ScalarTypeDefinition: {
            description: Read more about this kind on [spec.graphql.org](https://spec.graphql.org/October2021/#ScalarTypeDefinition).,
            type: boolean,
          },
          UnionTypeDefinition: {
            description: Read more about this kind on [spec.graphql.org](https://spec.graphql.org/October2021/#UnionTypeDefinition).,
            type: boolean,
          },
          rootField: {
            description: Definitions within \`Query\`, \`Mutation\`, and \`Subscription\` root types.,
            type: boolean,
          },
          types: {
            description: Includes:
- \`ObjectTypeDefinition\`
- \`InterfaceTypeDefinition\`
- \`EnumTypeDefinition\`
- \`ScalarTypeDefinition\`
- \`InputObjectTypeDefinition\`
- \`UnionTypeDefinition\`,
            type: boolean,
          },
        },
        type: object,
      },
      maxItems: 1,
      minItems: 1,
      type: array,
    },
    url: https://the-guild.dev/graphql/eslint/rules/require-description,
