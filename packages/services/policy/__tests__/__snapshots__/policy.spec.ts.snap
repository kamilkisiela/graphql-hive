[
  {
    description: Enforce arrange in alphabetical order for type fields, enum values, input object fields, operation selections and more.,
    name: alphabetize,
    recommended: false,
    schema: {
      items: {
        additionalProperties: false,
        minProperties: 1,
        properties: {
