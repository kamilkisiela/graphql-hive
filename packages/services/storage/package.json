{
  "name": "@hive/storage",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=12"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsx ../../../scripts/runify.ts",
    "db:generate": "schemats generate --config schemats.cjs -o src/db/types.ts && prettier --write src/db/types.ts"
  },
  "devDependencies": {
    "@graphql-inspector/core": "8.0.0",
    "@hive/postgres": "workspace:*",
    "@hive/service-common": "workspace:*",
    "@sentry/node": "catalog:",
    "@tgriesser/schemats": "9.0.1",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "dotenv": "catalog:",
    "fast-json-stable-stringify": "catalog:",
    "graphql": "^0.13.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "pg-promise": "catalog:",
    "typescript": "catalog:",
    "zod": "4.6.6"
  },
  "buildOptions": {
    "external": [
      "pg-native"
    ]
  }
}
