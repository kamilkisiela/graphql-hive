{
  "name": "@hive/server",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    "./supertokens-at-home/shared": "./src/supertokens-at-home/shared.ts"
  },
  "scripts": {
    "build": "tsx ../../../scripts/runify.ts src/index.ts src/persisted-documents-worker.ts && tsx ./scripts/copy-persisted-operations.mts",
    "dev": "tsup-node --config ../../../configs/tsup/dev.config.node.ts src/dev.ts src/persisted-documents-worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@envelop/core": "5.6.1",
    "@envelop/graphql-jit": "11.2.1",
    "@envelop/graphql-modules": "9.2.1",
    "@escape.tech/graphql-armor-max-aliases": "2.6.2",
    "@escape.tech/graphql-armor-max-depth": "2.4.2",
    "@escape.tech/graphql-armor-max-directives": "2.3.1",
    "@escape.tech/graphql-armor-max-tokens": "2.5.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "catalog:",
    "@fastify/formbody": "8.0.2",
    "@graphql-hive/plugin-opentelemetry": "catalog:",
    "@graphql-hive/yoga": "workspace:*",
    "@graphql-tools/merge": "catalog:",
    "@graphql-yoga/plugin-response-cache": "catalog:",
    "@graphql-yoga/redis-event-target": "catalog:",
    "@hive/api": "workspace:*",
    "@hive/cdn-script": "workspace:*",
    "@hive/postgres": "workspace:*",
    "@hive/pubsub": "workspace:*",
    "@hive/schema": "workspace:*",
    "@hive/service-common": "workspace:*",
    "@hive/storage": "workspace:*",
    "@hive/workflows": "workspace:*",
    "@sentry/node": "catalog:",
    "@swc/core": "catalog:",
    "@theguild/federation-composition": "catalog:",
    "@trpc/server": "catalog:",
    "@whatwg-node/server": "catalog:",
    "dotenv": "catalog:",
    "fastify": "catalog:",
    "got": "catalog:",
    "graphql": "catalog:",
    "graphql-yoga": "catalog:",
    "hyperid": "4.0.0",
    "openid-client": "6.8.2",
    "pino-pretty": "catalog:",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "3.25.76"
  },
  "buildOptions": {
    "external": [
      "pg-native"
    ]
  }
