{
  "annotations": {
    "list": []
  },
  "description": "Cilium egress policies (see deployment/services/egress-policy.ts). Workload -> host:port from the Hubble egress flow logs (Loki); drops and DNS from the ACNS Hubble metrics (per node).",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 11,
      "type": "stat",
      "title": "Would be blocked once enforced",
      "description": "Distinct workload -> host:port pairs in the selected time range that are only allowed by the observe-mode policy, i.e. not declared. Expected to be 0 before switching to `enforce`.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "refId": "A",
          "legendFormat": "",
          "expr": "count(sum by (workload, host, port) (count_over_time({namespace=\"kube-system\", container_name=\"hubble-egress-exporter\"} | json host=\"flow.destination_names[0]\", ip=\"flow.IP.destination\", port=\"flow.l4.TCP.destination_port\", verdict=\"flow.verdict\", match=\"flow.policy_match_type\" | regexp `\"k8s:app=(?P<workload>[^\"]+)\"` | label_format host=`{{ if .host }}{{ .host }}{{ else }}{{ .ip }}{{ end }}` | label_format allowlisted=`{{ if eq .match \"4\" }}no{{ else }}yes{{ end }}` | allowlisted=\"no\" [$__range]))) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
