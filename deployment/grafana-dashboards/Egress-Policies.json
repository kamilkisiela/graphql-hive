      "id": 4,
      "type": "stat",
      "title": "Failed DNS lookups (all nodes)",
      "description": "DNS responses other than NOERROR, for pods selected by a policy with DNS rules (e.g. unknown domains, search-domain expansion, refused lookups).",
      "datasource": {
