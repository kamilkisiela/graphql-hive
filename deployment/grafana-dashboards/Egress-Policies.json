{
  "annotations": {
    "list": []
  },
  "description": "Cilium egress policies (see deployment/services/egress-policy.ts): drops and DNS lookups per workload, from the Hubble metrics of Advanced Container Networking Services.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Policy drops",
      "description": "Packets dropped by the egress policies (`default` namespace) in the selected time range. Expected to be 0 in `observe` mode.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_DATASOURCE_UID"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROM_DATASOURCE_UID"
          },
          "editorMode": "code",
          "expr": "sum(increase(hubble_drop_total{reason=~\"POLICY_DENIED|POLICY_DENY\", source_namespace=\"default\", source_workload=~\"$workload\"}[$__range])) or vector(0)",
          "legendFormat": "Drops",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed DNS lookups",
      "description": "DNS responses other than NOERROR in the selected time range (e.g. unknown domains, or lookups refused by the DNS rules).",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_DATASOURCE_UID"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROM_DATASOURCE_UID"
          },
          "editorMode": "code",
          "expr": "sum(increase(hubble_dns_responses_total{rcode!=\"No Error\", source_namespace=\"default\", source_workload=~\"$workload\"}[$__range])) or vector(0)",
          "legendFormat": "Failures",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Workloads resolving DNS through the policy",
      "description": "Workloads with DNS visibility, i.e. selected by an egress policy.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_DATASOURCE_UID"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROM_DATASOURCE_UID"
          },
          "editorMode": "code",
          "expr": "count(count by (source_workload) (increase(hubble_dns_queries_total{source_namespace=\"default\", source_workload=~\"$workload\"}[$__range]) > 0)) or vector(0)",
          "legendFormat": "Workloads",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Policy drops by workload",
      "description": "Egress packets dropped by the policies, per source workload and protocol.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_DATASOURCE_UID"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROM_DATASOURCE_UID"
          },
          "editorMode": "code",
          "expr": "sum by (source_workload, protocol) (rate(hubble_drop_total{reason=~\"POLICY_DENIED|POLICY_DENY\", source_namespace=\"default\", source_workload=~\"$workload\"}[$__rate_interval]))",
          "legendFormat": "{{source_workload}} ({{protocol}})",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "All drops by reason",
      "description": "Every packet drop for the selected workloads, by reason (policy and non-policy).",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_DATASOURCE_UID"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROM_DATASOURCE_UID"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (rate(hubble_drop_total{source_namespace=\"default\", source_workload=~\"$workload\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DNS lookups by workload",
      "description": "DNS queries per workload, as seen by the Cilium DNS proxy.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_DATASOURCE_UID"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROM_DATASOURCE_UID"
          },
          "editorMode": "code",
          "expr": "sum by (source_workload) (rate(hubble_dns_queries_total{source_namespace=\"default\", source_workload=~\"$workload\"}[$__rate_interval]))",
          "legendFormat": "{{source_workload}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Failed DNS lookups by workload",
      "description": "DNS responses other than NOERROR, per workload and response code.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_DATASOURCE_UID"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROM_DATASOURCE_UID"
          },
          "editorMode": "code",
          "expr": "sum by (source_workload, rcode) (rate(hubble_dns_responses_total{rcode!=\"No Error\", source_namespace=\"default\", source_workload=~\"$workload\"}[$__rate_interval]))",
          "legendFormat": "{{source_workload}} ({{rcode}})",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "External hosts per workload",
      "description": "Hostnames each workload resolved in the selected time range (cluster-internal names excluded). Compare with the `allowExternal` declarations of each service before enforcing.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_DATASOURCE_UID"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PROM_DATASOURCE_UID"
          },
          "editorMode": "code",
          "expr": "sum by (source_workload, query) (increase(hubble_dns_queries_total{query!~\".*\\\\.cluster\\\\.local\\\\.?\", source_namespace=\"default\", source_workload=~\"$workload\"}[$__range])) > 0",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "source_workload",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "source_workload": "Workload",
              "query": "Host",
              "Value": "Lookups"
            }
          }
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["hive", "network"],
  "templating": {
    "list": [
      {
        "name": "workload",
        "label": "Workload",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PROM_DATASOURCE_UID"
        },
        "query": {
          "query": "label_values(hubble_dns_queries_total{source_namespace=\"default\"}, source_workload)",
          "refId": "workload"
        },
        "definition": "label_values(hubble_dns_queries_total{source_namespace=\"default\"}, source_workload)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Egress Policies"
}
