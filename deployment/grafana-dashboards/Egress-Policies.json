    {
      "id": 5,
      "type": "table",
      "title": "External destinations per workload",
      "description": "Every workload -> host:port from `default` to the internet in the selected time range, with the number of new connections. Allowlisted = matched a declaration of the service (`allowExternal` / `allowAnyExternal`). In `observe` mode, rows with Allowlisted = no only matched the observe-mode allow-all policy, and would be blocked once enforced. Host falls back to the IP when the connection wasn't preceded by a DNS lookup.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "sum by (workload, host, port, allowlisted, verdict) (count_over_time({namespace=\"kube-system\", container_name=\"hubble-egress-exporter\"} | json host=\"flow.destination_names[0]\", ip=\"flow.IP.destination\", port=\"flow.l4.TCP.destination_port\", verdict=\"flow.verdict\", match=\"flow.policy_match_type\" | regexp `\"k8s:app=(?P<workload>[^\"]+)\"` | label_format host=`{{ if .host }}{{ .host }}{{ else }}{{ .ip }}{{ end }}` | label_format allowlisted=`{{ if eq .match \"4\" }}no{{ else }}yes{{ end }}` [$__range]))",
          "legendFormat": "",
          "refId": "A",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Allowlisted"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "no": {
                        "color": "orange",
                        "index": 0,
                        "text": "no"
                      },
                      "yes": {
                        "color": "green",
                        "index": 1,
                        "text": "yes"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Allowlisted",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "workload": 0,
              "host": 1,
              "port": 2,
              "allowlisted": 3,
              "verdict": 4,
              "Value #A": 5
            },
            "renameByName": {
              "workload": "Workload",
              "host": "Host",
              "port": "Port",
              "allowlisted": "Allowlisted",
              "verdict": "Verdict",
              "Value #A": "Connections"
            }
          }
        }
      ]
    },
